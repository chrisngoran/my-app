# Copy this file to `.env` and fill in the values to enable accounts,
# cloud sync, and AI features. Without it, the app runs in local-only mode
# (data stays in your browser, AI features are hidden).
#
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Claude API key is NOT set here — it must never reach the browser.
# Set it as an Edge Function secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
